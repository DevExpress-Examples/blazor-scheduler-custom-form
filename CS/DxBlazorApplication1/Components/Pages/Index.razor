@page "/"
<PageTitle>Welcome</PageTitle>

<div class="main-content">
    <DxGridLayout CssClass="welcome-gridlayout" RowSpacing="3rem">
        <Rows>
            <DxGridLayoutRow Height="auto" Areas="header"></DxGridLayoutRow>
            <DxGridLayoutRow Height="auto" Areas="cards"></DxGridLayoutRow>
        </Rows>
        <Items>
            <DxGridLayoutItem Area="header" CssClass="title">
                <Template>
                    <div class="title-header-text">Scheduler Examples</div>
                </Template>
            </DxGridLayoutItem>
            <DxGridLayoutItem Area="cards" CssClass="welcome-cards">
                <Template>
                    <NavLink class="welcome-card" href="@UrlGenerator.GetUrl("/scheduler/basic", ToggledSidebar)">
                        <svg viewBox="0 0 16 16" class="welcome-card-img" alt="basic card">
                            <use href="images/scheduler/tz.svg"></use>
                        </svg>
                        <div class="welcome-card-text">Basic Scheduler</div>
                        <div class="welcome-card-back"></div>
                    </NavLink>
                    <NavLink class="welcome-card" href="@UrlGenerator.GetUrl("/scheduler/customform", ToggledSidebar)">
                        <svg viewBox="0 0 16 16" class="welcome-card-img" alt="custom form card">
                            <use href="images/scheduler/custom.svg"></use>
                        </svg>
                        <div class="welcome-card-text">Custom Form</div>
                        <div class="welcome-card-back"></div>
                    </NavLink>
                </Template>
            </DxGridLayoutItem>
        </Items>
    </DxGridLayout>
</div>

@code {
    [SupplyParameterFromQuery(Name = UrlGenerator.ToggleSidebarName)]
    public bool ToggledSidebar { get; set; }
}